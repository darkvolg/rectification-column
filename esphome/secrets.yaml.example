# Скопировать в secrets.yaml и заполнить СВОИМИ значениями.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml в git не коммитить — он закрыт в .gitignore.
# Подробности и что делать, если ключ утёк: ../УСТАНОВКА.md

# Домашняя сеть. ОБЯЗАТЕЛЬНО 2.4 ГГц — диапазон 5 ГГц ESP32 не видит.
wifi_ssid: "ИМЯ_СЕТИ"
wifi_password: "ПАРОЛЬ"

# Точка доступа на случай, если домашний WiFi отвалился.
# Минимум 8 символов, иначе ESP32 её не поднимет.
ap_password: "ПРИДУМАТЬ_8_СИМВОЛОВ"

# Ключ шифрования API для Home Assistant, 32 байта base64.
#   openssl rand -base64 32
# Либо генератор на странице компонента api в документации ESPHome,
# либо аддон ESPHome в HA предложит ключ сам при создании устройства.
api_encryption_key: "СГЕНЕРИРОВАТЬ_32_БАЙТА_BASE64"

# Пароль на прошивку по воздуху. Кто его знает и видит плату в сети —
# заливает в неё любой код. Длинный и случайный, не как у соседнего устройства.
#   openssl rand -base64 18
ota_password: "СГЕНЕРИРОВАТЬ_ДЛИННЫЙ"
