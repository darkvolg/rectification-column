# ============================================================
#  ЧТО НЕ ПОПАДАЕТ В РЕПОЗИТОРИЙ
#  Проект открытый. Один забытый файл — и чужой человек знает
#  пароль от домашнего WiFi и может перепрошить колонну по сети.
# ============================================================

# Ключи и пароли. Никогда, ни при каких обстоятельствах.
secrets.yaml
esphome/secrets.yaml
*secrets.yaml
!*secrets.yaml.example

# Долгоживущий токен Home Assistant, если он окажется в файле
*.token
ha_token*

# Собранная прошивка. Раздавать .bin нельзя: в нём зашиты ключи
# того, кто собирал, — у всех получатся одинаковые.
*.bin
*.elf

# Сборочный кэш ESPHome — 34 МБ, пересоздаётся сам
.esphome/
esphome/.esphome/
esphome/.pioenvs/
esphome/.piolibdeps/
esphome/.pio/

# Резервные копии и мусор редакторов
*.bak
*.bak_*
*~
.vscode/
.idea/
Thumbs.db
.DS_Store

# ============================================================
#  ЛИЧНОЕ — в публичный репозиторий не идёт
#  Экономика партии, цены, планы. К автоматике отношения не имеет.
# ============================================================
ЭКОНОМИКА.md
ACTION_PLAN_Автоматика.md
Калькулятор_себестоимости.html
